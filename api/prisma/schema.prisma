// Schéma Yamboka — voir docs/02 (Offre technique) §4 et docs/04.
// Montants en entiers (FCFA, crédits). Le registre CreditLedger est en ajout seul :
// un trigger SQL (migration "ledger_immutability") interdit UPDATE et DELETE.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Énumérations ─────────────

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum EmailTokenType {
  VERIFY_EMAIL // hérité : la vérification passe désormais par un code (EmailOtp), plus par un lien
  RESET_PASSWORD
}

enum OtpPurpose {
  VERIFY_EMAIL
  LOGIN
  SENSITIVE_ACTION
}

enum CreditTxType {
  PURCHASE
  FIRST_PURCHASE_BONUS
  /// Hérité : les crédits de bienvenue n'existent plus ; des lignes anciennes (registre immuable) peuvent subsister.
  WELCOME
  RESERVE
  CAPTURE
  RELEASE
  EXPIRE
  ADMIN_ADJUST
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

/// Origine de l'attribution des crédits d'un paiement : vérification automatique ou régularisation administrative.
enum CreditOrigin {
  AUTO
  MANUAL
}

/// Nature d'une tentative de vérification d'un paiement.
enum PaymentCheckKind {
  /// Interrogation de l'endpoint de statut du fournisseur (seule preuve automatique acceptée).
  PROVIDER
  /// Validation administrative sur preuve externe, quand le fournisseur est injoignable.
  MANUAL
}

enum MobileOperator {
  MTN
  AIRTEL
  /// Tout autre réseau (Orange, Moov, Wave…) : le réseau exact est dans Payment.network.
  OTHER
}

enum GenerationStatus {
  PENDING
  SUBMITTED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum BillingUnit {
  SECOND
  /// Abandonné (Yamboka ne produit que des vidéos) : conservé pour les données existantes, jamais utilisé par le code.
  IMAGE
}

enum ProductPhase {
  MVP
  PHASE_2
}

enum PresetType {
  MOTION
  LOOK
  OBJECT_SWAP
}

enum MediaRole {
  INPUT_VIDEO
  INPUT_IMAGE
  OUTPUT_VIDEO
  /// Abandonné : résultats d'images des anciennes créations, conservés (masqués) tant que le propriétaire n'a pas décidé.
  OUTPUT_IMAGE
  THUMBNAIL
  PRESET_THUMBNAIL
  PRESET_EXAMPLE_VIDEO
  PRESET_REFERENCE_IMAGE
}

enum MediaBucket {
  INPUTS
  OUTPUTS
  PRESETS
}

enum ReportStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum ModerationActionType {
  WARN
  SUSPEND
  BAN
  REACTIVATE
  HIDE_CREATION
  DELETE_CREATION
  VERIFY_CREATION
}

enum LegalDocType {
  CGU
  CHARTE
  CONFIDENTIALITE
}

enum NotificationType {
  GENERATION_READY
  GENERATION_FAILED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  CREDITS_REFUNDED
  /// Attribution de crédits par un administrateur (geste commercial, correction).
  CREDITS_GRANTED
  DELETION_REMINDER
  MODERATION
  SYSTEM
}

// ───────────── Utilisateurs et authentification ─────────────

model User {
  id               String     @id @default(uuid()) @db.Uuid
  firstName        String
  lastName         String
  email            String     @unique // toujours en minuscules (normalisé par l'API)
  emailVerifiedAt  DateTime?
  passwordHash     String? // null pour un compte Google uniquement
  avatarUrl        String?
  emailPrefs       Json? // préférences d'e-mail par événement (voir EmailPrefs) ; null = valeurs par défaut
  phone            String? // E.164 (+242066063133), non vérifié
  role             Role       @default(USER)
  status           UserStatus @default(ACTIVE)
  signupIp         String?
  welcomeGrantedAt DateTime?
  deletedAt        DateTime? // suppression de compte : anonymisation, traces conservées (RG-34)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  sessions         Session[]
  oauthAccounts    OAuthAccount[]
  emailTokens      EmailToken[]
  legalAcceptances LegalAcceptance[]
  lots             CreditLot[]
  ledger           CreditLedger[]               @relation("LedgerOwner")
  ledgerCreated    CreditLedger[]               @relation("LedgerCreator")
  payments         Payment[]
  paymentsSettled  Payment[]                    @relation("PaymentCreditedBy")
  paymentChecks    PaymentCheck[]
  generations      Generation[]
  quotes           CreationQuote[]
  mediaFiles       MediaFile[]
  reportsFiled     Report[]                     @relation("ReportReporter")
  reportsHandled   Report[]                     @relation("ReportHandler")
  moderationTarget ModerationAction[]           @relation("ModerationTarget")
  moderationActor  ModerationAction[]           @relation("ModerationActor")
  notifications    Notification[]
  auditLogs        AuditLog[]
  topUps           ProviderTopUp[]
  calibrations     ProviderBalanceCalibration[]
  payouts          PayoutRecord[]
  settingsUpdated  Setting[]

  @@index([status])
  @@index([createdAt])
  @@index([signupIp, createdAt])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique // le jeton brut n'est jamais stocké
  ip        String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OAuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  provider          String // "google"
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model EmailToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

/// Code à usage unique envoyé par e-mail. Le code n'est jamais stocké : seulement son HMAC.
model EmailOtp {
  id        String     @id @default(uuid()) @db.Uuid
  email     String
  purpose   OtpPurpose
  userId    String?    @db.Uuid
  codeHash  String
  attempts  Int        @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
}

/// État d'installation : une seule ligne (id = 1, contrainte CHECK en SQL). Sa présence verrouille définitivement le Setup Wizard.
model InstallState {
  id          Int      @id @default(1)
  completedAt DateTime @default(now())
  adminUserId String?  @db.Uuid
}

// ───────────── Textes légaux ─────────────

model LegalDocument {
  id          String       @id @default(uuid()) @db.Uuid
  type        LegalDocType
  version     Int
  content     String
  major       Boolean      @default(false) // une version majeure impose une nouvelle acceptation
  publishedAt DateTime     @default(now())

  acceptances LegalAcceptance[]

  @@unique([type, version])
}

model LegalAcceptance {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  documentId String   @db.Uuid
  acceptedAt DateTime @default(now())
  ip         String?

  user     User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  document LegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([userId, documentId])
}

// ───────────── Offre : packs, devises, produits, presets ─────────────

model CurrencySetting {
  currency    String  @id // ISO 4217, "XAF" au lancement
  creditValue Int // valeur d'un crédit dans cette devise (XAF = 25)
  active      Boolean @default(true)
  /// Bornes d'un achat à la quantité dans cette devise (montant payé). Les deux requis pour ouvrir l'achat libre ;
  /// absentes, seuls les packs de cette devise sont vendables. XAF et XOF gardent leurs bornes par défaut.
  minAmount   Int?
  maxAmount   Int?
}

model CreditPack {
  id                        String   @id @default(uuid()) @db.Uuid
  name                      String
  country                   String   @default("CG") // ISO 3166-1
  currency                  String   @default("XAF")
  price                     Int // dans la devise
  credits                   Int // crédits de base, hors bonus
  bonusPercent              Int      @default(0)
  sortOrder                 Int      @default(0)
  featured                  Boolean  @default(false)
  active                    Boolean  @default(true)
  /// Bonus de premier achat de ce pack, en %. null = valeur globale (réglage firstPurchaseBonusDefaultPercent) ; 0 = aucun bonus.
  firstPurchaseBonusPercent Int?
  /// Affichée sur les pages publiques (3 maximum, dont une recommandée). Un pack inactif n'est jamais public.
  publicVisible             Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  payments Payment[]

  @@unique([country, name])
}

model GenerationProduct {
  id                     String       @id @default(uuid()) @db.Uuid
  code                   String       @unique // VIDEO_LIGHT_480…
  name                   String
  providerModel          String
  resolution             String?
  billingUnit            BillingUnit
  creditsPerUnit         Int
  providerCostUsdPerUnit Decimal      @db.Decimal(10, 5)
  billableMultiplier     Int          @default(1) // Genjutsu Light : sortie + entrée = 2
  minSeconds             Int?
  maxSeconds             Int?
  phase                  ProductPhase @default(MVP)
  active                 Boolean      @default(false)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  presets     Preset[]
  generations Generation[]
}

model Preset {
  id             String     @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  category       String // danse, pub, anniversaire, mode…
  type           PresetType
  /// Hérité (Genjutsu) : une idée ne désigne plus de produit ; le produit se déduit de la résolution choisie.
  productId      String?    @db.Uuid
  defaultPrompt  String?
  requestedItems Json? // éléments demandés à l'utilisateur
  sortOrder      Int        @default(0)
  visible        Boolean    @default(false)
  /// Mise en avant éditoriale (« à la une »), distincte de la publication : décidée par l'administrateur.
  featured       Boolean    @default(false)
  /// Public visé : « business » ou « perso » (classement des idées à l'écran).
  audience       String     @default("business")
  /// Conseil sur la photo à envoyer pour cette idée.
  photoHint      String?
  /// Réglages proposés par défaut (modifiables par le client) : { format, resolution, durationSeconds }.
  defaults       Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  product     GenerationProduct? @relation(fields: [productId], references: [id], onDelete: Restrict)
  media       MediaFile[]
  generations Generation[]

  @@index([visible, sortOrder])
}

// ───────────── Catalogue international des paiements ─────────────

enum CatalogStatus {
  ACTIVE // ouvert aux paiements
  COMING_SOON // intégré, affiché « Bientôt disponible », non sélectionnable
  DISABLED // désactivé volontairement : jamais proposé
}

enum PaymentMethodType {
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
}

/// Pays (ou zone « International », iso XX) où Yamboka peut encaisser. Seul `status` est piloté par l'administrateur.
model Country {
  iso                  String        @id // ISO 3166-1 alpha-2 ; « XX » = International
  name                 String
  dialCode             String // sans « + » ; vide pour International
  currency             String // ISO 4217
  status               CatalogStatus @default(DISABLED)
  /// Frais indicatifs affichés par SasPay (information, jamais ajoutés au prix du client).
  indicativeFeePercent Decimal?      @db.Decimal(6, 3)
  indicativeFeeNote    String? // « Dès 2,5 % », « Non indiqué »
  sortOrder            Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  methods CountryPaymentMethod[]

  @@index([status, sortOrder])
}

/// Moyen de paiement générique (MTN MoMo, Wave, Carte bancaire…) partageable entre pays.
model PaymentMethod {
  code      String            @id // MTN_MOMO, WAVE, CARD…
  name      String
  type      PaymentMethodType
  config    Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  countries CountryPaymentMethod[]
}

/// Association pays ↔ moyen de paiement, avec son propre statut.
model CountryPaymentMethod {
  id                   String        @id @default(uuid()) @db.Uuid
  countryIso           String
  methodCode           String
  status               CatalogStatus @default(DISABLED)
  /// Code du réseau chez SasPay (ex. mtn_rw) ; null = non pris en charge par SasPay d'après sa documentation.
  saspayNetwork        String?
  /// Raison pour laquelle le moyen ne peut pas être activé (technique, pas administrable) : NOT_IN_SASPAY,
  /// OTP_BEFORE, OTP_AFTER, INACTIVE_AT_SASPAY, CARD_FLOW_NOT_INTEGRATED. null = activable.
  limitation           String?
  indicativeFeePercent Decimal?      @db.Decimal(6, 3)
  indicativeFeeNote    String?
  note                 String? // précision humaine (ex. correspondance de marque à confirmer)
  config               Json?
  sortOrder            Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  country Country       @relation(fields: [countryIso], references: [iso], onDelete: Restrict)
  method  PaymentMethod @relation(fields: [methodCode], references: [code], onDelete: Restrict)

  @@unique([countryIso, methodCode])
  @@index([methodCode])
  @@index([status])
}

// ───────────── Paiements et crédits ─────────────

model Payment {
  id                        String         @id @default(uuid()) @db.Uuid
  userId                    String         @db.Uuid
  /// null = achat de crédits sur mesure (quantité libre, sans pack ni bonus).
  packId                    String?        @db.Uuid
  country                   String
  currency                  String
  amount                    Int
  credits                   Int // crédits totaux (bonus inclus) fixés à la création
  bonusCredits              Int            @default(0) // part « bonus » des crédits totaux (mouvement BONUS)
  gateway                   String // « saspay » ou « mock » (développement) ; une éventuelle ancienne valeur « openpay » reste lisible, jamais réécrite
  operator                  MobileOperator
  payerPhone                String
  externalReference         String?        @unique // référence fournisseur, connue après l'appel au fournisseur (unicité = RG-05)
  /// Montant réellement envoyé au fournisseur (prix affiché moins les frais d'encaissement absorbés par Yamboka). `amount` reste le prix affiché.
  sentAmount                Int?
  /// Code du réseau chez le fournisseur (ex. SasPay /networks/). `operator` reste utilisé par le fournisseur simulé.
  network                   String?
  /// Instantané du catalogue au moment du paiement : l'historique ne change plus si le catalogue évolue.
  countryName               String?
  methodCode                String?
  methodName                String?
  /// Tarif appliqué au calcul du montant envoyé : palier, source (my-rates ou surcharge), date.
  feeSnapshot               Json?
  /// Clé d'idempotence du fournisseur : unique par intention de paiement, réutilisée à chaque nouvelle tentative réseau.
  idempotencyKey            String?        @unique
  /// Requête d'initiation EXACTE envoyée au fournisseur (sans secret). Rejouée à l'identique après un délai dépassé :
  /// une Idempotency-Key réutilisée avec un corps différent est refusée (409) et ne protégerait plus du doublon.
  providerRequest           Json?
  checkoutUrl               String? // redirection exigée par certains réseaux
  /// Constatés par la vérification du fournisseur (frais client, montant débité).
  clientFee                 Int?
  debitedAmount             Int?
  /// Net RÉELLEMENT reçu sur le compte de l'encaisseur, en FCFA : prix affiché moins les frais observés.
  /// C'est lui, et non le prix affiché, qui vaut quelque chose pour la plateforme.
  netReceived               Int?
  /// Frais observés et frais attendus, en % du prix affiché. Un écart de plus de 0,5 point déclenche une
  /// alerte : la grille du fournisseur a changé, ou le palier appliqué n'est pas celui qu'on croyait.
  observedFeePercent        Decimal?       @db.Decimal(7, 4)
  expectedFeePercent        Decimal?       @db.Decimal(7, 4)
  /// Pourcentage de bonus de premier achat promis au moment de la création (figé).
  firstPurchaseBonusPercent Int?
  status                    PaymentStatus  @default(INITIATED)
  lastProviderStatus        Json?
  failureReason             String?
  /// Horodatage de l'attribution des crédits. null sur un paiement SUCCESS = anomalie « confirmé non crédité ».
  creditedAt                DateTime?
  /// Comment les crédits ont été attribués : AUTO (confirmation du fournisseur) ou MANUAL (régularisation admin).
  creditOrigin              CreditOrigin?
  /// Administrateur ayant régularisé le paiement, le cas échéant (jamais renseigné pour une attribution AUTO).
  creditedById              String?        @db.Uuid
  /// Nombre de tentatives de traitement (vérification auprès du fournisseur), date et dernière erreur.
  reconcileAttempts         Int            @default(0)
  lastReconcileAt           DateTime?
  lastReconcileError        String?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  user       User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  creditedBy User?          @relation("PaymentCreditedBy", fields: [creditedById], references: [id], onDelete: Restrict)
  pack       CreditPack?    @relation(fields: [packId], references: [id], onDelete: Restrict)
  ledger     CreditLedger[]
  lots       CreditLot[]
  checks     PaymentCheck[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt, id])
  @@index([gateway, createdAt])
  @@index([country, createdAt])
  // Recalibrage des frais entrants : tous les paiements crédités d'un (pays, moyen de paiement).
  @@index([country, methodCode, creditedAt])
  @@index([methodCode])
  /// Repérage immédiat des paiements confirmés non crédités (anomalie à régulariser).
  @@index([status, creditedAt])
}

/// Trace, en ajout seul, de CHAQUE tentative de vérification d'un paiement : qui l'a déclenchée, ce que le
/// fournisseur a répondu, et la conclusion retenue. Sert à auditer une régularisation et à diagnostiquer un blocage.
model PaymentCheck {
  id             String           @id @default(uuid()) @db.Uuid
  paymentId      String           @db.Uuid
  kind           PaymentCheckKind
  /// Ce qui a déclenché la vérification : callback, webhook, reconcile, admin.
  source         String
  /// Conclusion : success, pending, failed, cancelled, unavailable, invalid_response, amount_mismatch, manual_proof.
  outcome        String
  /// Montant et devise annoncés par le fournisseur, quand il a répondu.
  amount         Int?
  currency       String?
  /// Référence de preuve externe (relevé marchand) pour une validation administrative.
  proofReference String?
  detail         String?
  actorId        String?          @db.Uuid
  createdAt      DateTime         @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
}

/// Notification de paiement reçue d'un fournisseur, signature VÉRIFIÉE. Sert à dédupliquer les rejeux et à tracer ce qui
/// a déclenché une vérification. Son contenu n'est jamais utilisé pour créditer : seule la vérification auprès du
/// fournisseur décide. Pas de clé étrangère : une notification peut arriver avant que la référence soit enregistrée.
model PaymentWebhookEvent {
  id           String    @id @default(uuid()) @db.Uuid
  gateway      String
  /// Identifiant de la transaction chez le fournisseur (= Payment.externalReference).
  providerTxId String
  event        String
  paymentId    String?   @db.Uuid
  /// Résumé expurgé (statut, montant, devise) : ni numéro de téléphone ni en-tête.
  payload      Json
  receivedAt   DateTime  @default(now())
  processedAt  DateTime?

  @@unique([gateway, providerTxId, event])
  @@index([paymentId])
  @@index([receivedAt])
}

/// Tarif d'encaissement imposé par l'administrateur pour un pays et un réseau. Optionnel : la source principale
/// est GET /pricing/my-rates/ de SasPay ; une ligne active ici la remplace pour ce pays et ce réseau.
model FeeRateOverride {
  id          String   @id @default(uuid()) @db.Uuid
  country     String // ISO 3166-1
  network     String // code du réseau chez le fournisseur
  percent     Decimal  @db.Decimal(7, 4) // 5.7 = 5,7 %
  fixed       Decimal  @default(0) @db.Decimal(12, 2)
  floorAmount Decimal? @db.Decimal(12, 2)
  capAmount   Decimal? @db.Decimal(12, 2)
  active      Boolean  @default(true)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([country, network])
}

enum CreditLotKind {
  PURCHASE
  FIRST_PURCHASE_BONUS
  ADMIN_ADJUST
}

/// Lot de crédits avec échéance. Le journal (CreditLedger) reste la source de vérité et immuable ;
/// `remaining` est un état dérivé, mis à jour dans la même transaction que le mouvement qui l'explique.
model CreditLot {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  kind          CreditLotKind
  initialAmount Int
  remaining     Int
  expiresAt     DateTime
  /// Mouvement du journal qui a créé le lot (un lot pour un mouvement). Volontairement sans clé étrangère :
  /// CreditLedger ne doit avoir aucune référence entrante (sinon TRUNCATE échoue avant le trigger d'immuabilité).
  ledgerId      String?       @unique @db.Uuid
  paymentId     String?       @db.Uuid
  createdAt     DateTime      @default(now())

  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  payment     Payment?        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  allocations LotAllocation[]

  @@index([userId, expiresAt])
}

/// Part d'une réservation prélevée sur un lot : permet de restituer les crédits au bon lot en cas d'échec.
model LotAllocation {
  id           String   @id @default(uuid()) @db.Uuid
  lotId        String   @db.Uuid
  generationId String   @db.Uuid
  amount       Int // crédits prélevés sur le lot
  returned     Int      @default(0) // crédits restitués au lot (libération)
  createdAt    DateTime @default(now())

  lot        CreditLot  @relation(fields: [lotId], references: [id], onDelete: Restrict)
  generation Generation @relation(fields: [generationId], references: [id], onDelete: Restrict)

  @@unique([lotId, generationId])
  @@index([generationId])
}

/// Prix fournisseur d'un modèle de génération, en dollars par seconde. Le coût en crédits n'est jamais stocké :
/// il se calcule avec le taux FCFA/$ et le coût du crédit (réglages administrables), voir billing/credits.ts.
model ModelPricing {
  id                    String   @id @default(uuid()) @db.Uuid
  code                  String   @unique
  name                  String
  providerModel         String
  resolution            String?
  usdPerSecond          Decimal  @db.Decimal(10, 5)
  /// Prix par seconde avec l'audio natif. null = le modèle n'a pas cette option.
  usdPerSecondWithAudio Decimal? @db.Decimal(10, 5)
  minSeconds            Int      @default(1)
  maxSeconds            Int      @default(10)
  /// Modèle de référence pour les équivalences affichées (« ≈ 12 vidéos de 10 s »). Un seul à la fois.
  isDefault             Boolean  @default(false)
  active                Boolean  @default(false)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// Transactions du faux fournisseur de paiement (PAYMENT_PROVIDER=mock) : l'état « côté opérateur ».
/// Le vrai fournisseur est externe et persistant ; le mock l'est donc aussi, pour survivre à un redémarrage.
model MockPaymentTransaction {
  reference   String   @id
  amount      Int
  currency    String
  phone       String
  operator    String
  status      String   @default("pending") // pending | success | failed | cancelled
  failureMode String? // provider_error | invalid_response : simule un fournisseur défaillant
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CreditLedger {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  amount       Int // signé ; jamais modifié ni supprimé (RG-02)
  type         CreditTxType
  reference    String       @unique // déterministe : pay:…, reserve:…, refund:…
  generationId String?      @db.Uuid
  paymentId    String?      @db.Uuid
  expiresAt    DateTime?
  note         String?
  createdById  String?      @db.Uuid
  createdAt    DateTime     @default(now())

  user       User        @relation("LedgerOwner", fields: [userId], references: [id], onDelete: Restrict)
  createdBy  User?       @relation("LedgerCreator", fields: [createdById], references: [id], onDelete: Restrict)
  generation Generation? @relation(fields: [generationId], references: [id], onDelete: Restrict)
  payment    Payment?    @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([type, expiresAt])
  @@index([generationId])
  @@index([paymentId])
}

// ───────────── Générations et médias ─────────────

model Generation {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @db.Uuid
  /// Hérité : produit de l'ancien catalogue. Conservé pour l'historique, plus jamais lu pour une
  /// nouvelle création (le catalogue GenerationModel fait foi). Nullable depuis le catalogue unique.
  productId         String?          @db.Uuid
  /// Modèle du catalogue utilisé, et son slug FIGÉ au moment de la soumission (le catalogue peut changer).
  modelId           String?          @db.Uuid
  modelSlug         String?
  /// `input` EXACT envoyé au fournisseur, figé (aucun secret : les identifiants ne sont pas dans l'input).
  providerInput     Json?
  presetId          String?          @db.Uuid
  status            GenerationStatus @default(PENDING)
  prompt            String?
  /// Choix de l'utilisateur : texte, prix, téléphone, format (voir GenerationOptions dans @yamboka/shared).
  options           Json?
  billableSeconds   Int?
  creditsCost       Int
  /// Coût fournisseur FIGÉ à la création, en micro-dollars. Jamais recalculé : un changement de tarif ne
  /// réécrit pas ce qui a été engagé. null = création antérieure au journal en dollars.
  costMicroUsd      BigInt?
  /// Taux sortant (FCFA/$) retenu au moment de la création, figé.
  pricingRate       Decimal?         @db.Decimal(12, 4)
  /// Marge commerciale appliquée (%), figée.
  marginPercent     Decimal?         @db.Decimal(7, 4)
  /// Valeur FCFA de la création au moment où elle a été faite (coût × taux × marge), figée.
  priceFcfa         Int?
  /// Lignes de tarif et de paramètres utilisées (sans clé étrangère : ces tables sont en ajout seul).
  modelPriceId      String?          @db.Uuid
  pricingConfigId   String?          @db.Uuid
  providerRequestId String?
  providerStatusUrl String?
  errorMessage      String?
  /// Raison normalisée de l'échec (MODERATION, TIMEOUT, NO_RESULT, BAD_RESULT, FORMAT, UNSUPPORTED, PROVIDER, CANCELED) :
  /// choisit le message montré à l'utilisateur. `errorMessage` garde le détail technique, jamais affiché tel quel.
  failureCode       String?
  consentAt         DateTime // consentement horodaté (RG-31)
  consentIp         String?
  hidden            Boolean          @default(false)
  retentionHold     Boolean          @default(false) // gel lié à un signalement (RG-28)
  inputsPurgedAt    DateTime?
  outputExpiresAt   DateTime?
  outputPurgedAt    DateTime?
  reminderSentAt    DateTime?
  /// Supprimée par son propriétaire : fichiers purgés, trace conservée (RG-27).
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  submittedAt       DateTime?
  completedAt       DateTime?

  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  product     GenerationProduct? @relation(fields: [productId], references: [id], onDelete: Restrict)
  model       GenerationModel?   @relation(fields: [modelId], references: [id], onDelete: Restrict)
  preset      Preset?            @relation(fields: [presetId], references: [id], onDelete: SetNull)
  media       MediaFile[]
  ledger      CreditLedger[]
  allocations LotAllocation[]
  reports     Report[]
  moderation  ModerationAction[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([outputExpiresAt])
  // Liste d'administration : tri global par date, départagé par l'identifiant.
  @@index([createdAt, id])
}

model MediaFile {
  id           String      @id @default(uuid()) @db.Uuid
  role         MediaRole
  bucket       MediaBucket
  key          String // clé objet ; fichiers privés, URL signées uniquement
  mimeType     String
  sizeBytes    Int
  durationMs   Int?
  width        Int?
  height       Int?
  ownerId      String?     @db.Uuid
  generationId String?     @db.Uuid
  presetId     String?     @db.Uuid
  verifiedAt   DateTime? // contrôle du type réel / ffprobe effectué
  purgedAt     DateTime? // fichier supprimé, trace conservée (RG-27)
  createdAt    DateTime    @default(now())

  owner      User?       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  generation Generation? @relation(fields: [generationId], references: [id], onDelete: Restrict)
  preset     Preset?     @relation(fields: [presetId], references: [id], onDelete: Cascade)

  @@unique([bucket, key])
  @@index([generationId])
  @@index([ownerId])
}

// ───────────── Modération ─────────────

model Report {
  id              String       @id @default(uuid()) @db.Uuid
  generationId    String?      @db.Uuid
  reporterUserId  String?      @db.Uuid
  reporterContact String? // signalement public sans compte
  reason          String
  details         String?
  status          ReportStatus @default(NEW)
  handledById     String?      @db.Uuid
  resolution      String?
  createdAt       DateTime     @default(now())
  handledAt       DateTime?

  generation Generation? @relation(fields: [generationId], references: [id], onDelete: Restrict)
  reporter   User?       @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  handler    User?       @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([generationId])
}

model ModerationAction {
  id           String               @id @default(uuid()) @db.Uuid
  targetUserId String?              @db.Uuid
  generationId String?              @db.Uuid
  action       ModerationActionType
  reason       String
  actorId      String               @db.Uuid
  createdAt    DateTime             @default(now())

  targetUser User?       @relation("ModerationTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  generation Generation? @relation(fields: [generationId], references: [id], onDelete: Restrict)
  actor      User        @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([targetUserId])
  @@index([generationId])
}

// ───────────── Finances ─────────────

enum ModelPriceSource {
  /// Saisi par un administrateur (relevé de la grille publique du fournisseur, essai réel).
  MANUAL
  /// Obtenu du point d'estimation du fournisseur (POST /estimate/{modèle}).
  ESTIMATE
}

/**
 * Paramètres de tarification, VERSIONNÉS : une ligne par changement, jamais de mise à jour. Le prix d'une
 * génération se calcule avec la ligne en vigueur à sa date, donc un changement ne réécrit jamais le passé.
 */
model PricingConfig {
  id                    String   @id @default(uuid()) @db.Uuid
  /// Marge commerciale appliquée au coût fournisseur, en % « humain » (10 = 10 %).
  marginPercent         Decimal  @db.Decimal(7, 4)
  /// Marge de sécurité sur le change ajoutée au taux sortant mesuré, en %.
  fxBufferPercent       Decimal  @db.Decimal(7, 4)
  /// Taux carte FCFA/$ et perte de circuit estimée : servent SEULEMENT tant qu'aucune recharge n'est mesurée.
  cardFcfaPerUsd        Decimal  @db.Decimal(12, 4)
  circuitLossPercent    Decimal  @db.Decimal(7, 4)
  /// Dollars gardés en permanence sur le compte fournisseur, en micro-dollars (jamais engagés).
  safetyMarginMicroUsd  BigInt
  /// Plafonds quotidiens de dépense fournisseur, en micro-dollars : tous utilisateurs, puis par utilisateur.
  dailyCapMicroUsd      BigInt
  dailyUserCapMicroUsd  BigInt
  /// Part du bonus de premier achat comptée dans la valeur d'un crédit, en % : 100 au lancement (prudent, le
  /// bonus compte sur chaque crédit), à abaisser plus tard vers la part réellement observée sur les ventes.
  bonusValuationPercent Decimal  @default(100) @db.Decimal(7, 4)
  /// Frais de chaque étape du circuit de recharge, en % : retrait SasPay, MoMo → carte, recharge
  /// fournisseur. PROVISOIRES tant que `provisional` est vrai : une fois r_out mesuré, c'est lui qui fait foi.
  withdrawalFeePercent  Decimal  @default(1) @db.Decimal(7, 4)
  momoToCardFeePercent  Decimal  @default(0) @db.Decimal(7, 4)
  topUpFeePercent       Decimal  @default(0) @db.Decimal(7, 4)
  /// Marge nette minimale acceptée, en % : en dessous, l'application exige une confirmation renforcée.
  minMarginPercent      Decimal  @default(5) @db.Decimal(7, 4)
  /// Achat minimum sur mesure, en FCFA : en dessous, la marge nette ne serait plus positive.
  minPurchaseXaf        Int      @default(500)
  /// Durée de validité d'un devis déjà affiché, en secondes.
  quoteValiditySeconds  Int      @default(600)
  /// Version dont celle-ci est le retour en arrière, ou null (un retour crée une version, jamais de suppression).
  revertedFromId        String?  @db.Uuid
  /// Minimum de retrait imposé par l'encaisseur, en FCFA : les recharges se font par lots d'au moins ce montant.
  minWithdrawalXaf      Int
  /// true = au moins une valeur n'est pas mesurée. L'administration l'affiche, et la production reste à valider.
  provisional           Boolean  @default(true)
  /// Date d'entrée en vigueur : la ligne retenue est la plus récente dont la date est passée.
  effectiveFrom         DateTime
  note                  String?
  createdById           String?  @db.Uuid
  createdAt             DateTime @default(now())

  @@index([effectiveFrom])
}

/**
 * Tarif fournisseur d'un modèle à une date, en ajout seul : un changement AJOUTE une ligne, on ne modifie
 * jamais l'ancienne. Le prix est en micro-dollars entiers par unité facturée (seconde pour la vidéo).
 */
model ModelPrice {
  id                 String           @id @default(uuid()) @db.Uuid
  /// Chemin du modèle chez le fournisseur (= GenerationProduct.providerModel).
  providerModel      String
  /// Résolution facturée séparément (« 480p »), ou null si le tarif ne dépend pas de la résolution.
  resolution         String?
  /// Format facturé séparément, ou null (Wan 3.0 : le format ne change pas le prix).
  format             String?
  billingUnit        BillingUnit      @default(SECOND)
  /// Prix fournisseur par unité facturée, en micro-dollars (0,05 $/s → 50000).
  microUsdPerUnit    BigInt
  /// Unités facturées par unité produite (une sortie + une entrée = 2).
  billableMultiplier Int              @default(1)
  minSeconds         Int?
  maxSeconds         Int?
  source             ModelPriceSource
  effectiveFrom      DateTime
  note               String?
  createdById        String?          @db.Uuid
  createdAt          DateTime         @default(now())

  @@index([providerModel, resolution, effectiveFrom])
  @@index([effectiveFrom])
}

/// Nature d'un mouvement du solde prépayé du fournisseur de génération. Le solde n'est JAMAIS écrit :
/// il est toujours la somme des mouvements (RG-02 appliqué aux dollars).
enum ProviderLedgerType {
  /// Recharge du compte fournisseur (+). Porte le taux r_out mesuré pour cette recharge.
  TOPUP
  /// Réservation à la soumission d'une génération (−) : l'argent est engagé avant d'être dépensé.
  GENERATION_RESERVE
  /// Génération réussie : la réservation devient définitive. Montant 0 (le débit a eu lieu à la réservation).
  GENERATION_CAPTURE
  /// Génération échouée : la réservation est restituée (+). Le fournisseur ne facture pas un échec.
  GENERATION_RELEASE
  /// Recalage sur le solde lu dans la console du fournisseur (±) : seule écriture qui corrige une dérive.
  CALIBRATION
  /// Correction manuelle motivée (±), hors recalage.
  ADJUSTMENT
}

/// Journal du solde prépayé du fournisseur, en ajout seul, en MICRO-dollars entiers (1 $ = 1 000 000).
/// Volontairement sans clé étrangère entrante, comme CreditLedger : aucune table ne le référence.
model ProviderLedger {
  id             String             @id @default(uuid()) @db.Uuid
  provider       String             @default("higgsfield")
  type           ProviderLedgerType
  /// Montant SIGNÉ en micro-dollars. Entier : aucun flottant ne touche l'argent.
  amountMicroUsd BigInt
  /// Référence déterministe et unique (« topup:<id> », « hfreserve:<generationId> », « calib:<id> ») :
  /// un même événement rejoué n'écrit qu'un mouvement.
  reference      String             @unique
  generationId   String?            @db.Uuid
  /// Recharge d'origine, pour un mouvement TOPUP (sans clé étrangère : ProviderLedger ne référence rien).
  topUpId        String?            @db.Uuid
  /// Taux FCFA/$ attaché au mouvement : r_out mesuré pour une recharge, r_pricing figé pour une génération.
  fcfaPerUsd     Decimal?           @db.Decimal(12, 4)
  note           String?
  createdById    String?            @db.Uuid
  createdAt      DateTime           @default(now())

  @@index([provider, createdAt])
  @@index([type, createdAt])
  @@index([generationId])
}

/// Solde lu à la main dans la console du fournisseur (Billing) : la seule mesure vraie, l'API ne l'expose pas.
/// On enregistre l'écart avec l'estimation au moment de la lecture ; le recalage est un mouvement CALIBRATION.
model ProviderBalanceCalibration {
  id                String   @id @default(uuid()) @db.Uuid
  provider          String   @default("higgsfield")
  /// Solde lu dans la console, en micro-dollars.
  readMicroUsd      BigInt
  /// Solde estimé par le journal à l'instant de la lecture (figé : jamais recalculé).
  estimatedMicroUsd BigInt
  /// readMicroUsd − estimatedMicroUsd : négatif = on a dépensé plus que ce que le journal savait.
  deltaMicroUsd     BigInt
  /// Date de la lecture dans la console, distincte de la date d'enregistrement.
  readAt            DateTime @default(now())
  note              String?
  createdById       String   @db.Uuid
  createdAt         DateTime @default(now())

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
}

/// Recharge du compte fournisseur, avec le détail des frais de chaque étape (SasPay → MoMo → carte → dollars).
/// C'est la seule source de `r_out` : FCFA NETS retirés de SasPay ÷ dollars arrivés chez le fournisseur.
model ProviderTopUp {
  id                 String   @id @default(uuid()) @db.Uuid
  provider           String   @default("higgsfield")
  amountUsd          Decimal  @db.Decimal(10, 2)
  /// FCFA débités de la carte.
  amountXaf          Int
  /// FCFA retirés du solde SasPay pour cette recharge.
  saspayWithdrawnXaf Int?
  /// Taux effectif FCFA/$ constaté (calculé à la saisie).
  fxRate             Decimal  @db.Decimal(10, 4)
  /// Dollars RÉELLEMENT arrivés chez le fournisseur, en micro-dollars entiers : source de vérité du calcul.
  amountMicroUsd     BigInt?
  /// FCFA NETS sortis du portefeuille SasPay (après frais de retrait) : numérateur de r_out.
  netWithdrawnXaf    Int?
  /// Frais étape par étape : [{ step, amountXaf, feeXaf, note }]. Saisi une fois, jamais réécrit.
  feeSteps           Json?
  /// r_out = netWithdrawnXaf ÷ (amountMicroUsd / 1e6), figé à la saisie et jamais recalculé.
  rOut               Decimal? @db.Decimal(12, 4)
  /// false = saisie incomplète (une étape estimée) : l'administration l'affiche « non mesuré » et ne s'y fie pas.
  measured           Boolean  @default(false)
  /// Date de la recharge (saisie), distincte de la date d'enregistrement.
  occurredAt         DateTime @default(now())
  /// Date à laquelle le taux mesuré de CETTE recharge a été appliqué à la grille, ou null s'il attend
  /// encore la confirmation d'un administrateur. Tant qu'il attend, la grille garde le taux provisoire :
  /// saisir une recharge ne change jamais un prix à l'insu de qui la saisit.
  appliedToPricingAt DateTime?
  note               String?
  createdById        String   @db.Uuid
  createdAt          DateTime @default(now())

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([provider, occurredAt])
  @@index([provider, appliedToPricingAt])
}

model PayoutRecord {
  id            String   @id @default(uuid()) @db.Uuid
  amountXaf     Int
  commissionXaf Int
  date          DateTime
  note          String?
  createdById   String   @db.Uuid
  createdAt     DateTime @default(now())

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
}

// ───────────── Configuration, notifications, audit ─────────────

model Setting {
  key         String   @id
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model Notification {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @db.Uuid
  type          NotificationType
  title         String
  body          String
  link          String?
  readAt        DateTime?
  createdAt     DateTime         @default(now())
  /// Clé d'idempotence de l'événement (« gen-ready:<id> ») : un événement rejoué ne crée qu'une notification.
  dedupKey      String?          @unique
  /// E-mail à envoyer (préférence activée et adresse vérifiée à la création), pas encore parti.
  emailPending  Boolean          @default(false)
  emailSentAt   DateTime?
  emailAttempts Int              @default(0)
  emailError    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  reason     String?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ───────────── Catalogue de modèles ─────────────

/// Mode d'un modèle de génération : ce qu'il prend en entrée. Le catalogue en gère plusieurs, mais seuls les
/// modes effectivement implémentés côté parcours client peuvent être activés.
enum GenerationMode {
  /// Un texte seul produit la vidéo.
  TEXT_TO_VIDEO
  /// Une photo (première image) et un texte produisent la vidéo.
  IMAGE_TO_VIDEO
}

/// Type d'une valeur de paramètre, pour valider ce que le client envoie.
enum ModelParamType {
  STRING
  INTEGER
  BOOLEAN
  ENUM
}

/// Rôle d'un paramètre dans le calcul et dans le formulaire. Le serveur sait ainsi lequel porte la durée, la
/// résolution, etc., sans connaître les noms exacts du fournisseur.
enum ModelParamRole {
  PROMPT
  DURATION
  RESOLUTION
  ASPECT_RATIO
  /// URL de l'image d'entrée, déposée par le serveur (modes image → vidéo). Jamais saisie par le client.
  IMAGE_URL
  OPTION
}

/// Qui décide de la valeur d'un paramètre.
enum ModelParamExposure {
  /// Le client choisit, dans les valeurs autorisées.
  CLIENT
  /// Valeur imposée par la configuration : une valeur envoyée par le client est refusée.
  FIXED
  /// Valeur par défaut envoyée au fournisseur, jamais montrée ni acceptée du client.
  HIDDEN_DEFAULT
}

/// Comment une option payante modifie le tarif de base.
enum ModelOptionPriceKind {
  /// Supplément en micro-dollars, par unité facturée.
  SURCHARGE
  /// Multiplicateur du tarif, en points de base (10000 = ×1).
  MULTIPLIER
}

/**
 * Modèle du catalogue : tout ce que le serveur doit savoir pour appeler le fournisseur et facturer, SANS
 * aucun nom de modèle en dur dans le code. Un appel fournisseur, c'est toujours (slug, input) : le slug est
 * ici, l'`input` est reconstruit à partir de ModelParam. Les identifiants d'API viennent de l'environnement,
 * jamais du catalogue.
 */
model GenerationModel {
  id          String         @id @default(uuid()) @db.Uuid
  /// Chemin exact chez le fournisseur (« alibaba/wan-3.0-prime/text-to-video »).
  slug        String         @unique
  /// Nom affiché au client et à l'administration.
  name        String
  description String?
  mode        GenerationMode @default(TEXT_TO_VIDEO)
  /// Un modèle inactif est refusé immédiatement : aucun devis, aucune génération.
  active      Boolean        @default(false)
  /// Modèle retenu quand le client n'en choisit pas (un seul à la fois).
  isDefault   Boolean        @default(false)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  params      ModelParam[]
  generations Generation[]

  @@index([active, sortOrder])
}

/**
 * Un paramètre de l'`input` envoyé au fournisseur : sa clé EXACTE, son type, son rôle, qui le choisit, les
 * valeurs autorisées et s'il change le prix. Le serveur reconstruit l'`input` à partir de ces lignes et
 * refuse toute clé ou valeur absente du catalogue.
 */
model ModelParam {
  id            String             @id @default(uuid()) @db.Uuid
  modelId       String             @db.Uuid
  /// Clé exacte attendue par le fournisseur (« aspect_ratio », « generate_audio »).
  key           String
  /// Libellé montré au client dans le formulaire généré, ou null (la clé sert alors de libellé).
  label         String?
  type          ModelParamType
  role          ModelParamRole
  exposure      ModelParamExposure @default(CLIENT)
  /// Valeurs autorisées : liste pour ENUM (["480p","720p"]), bornes pour INTEGER ({"min":2,"max":30}),
  /// longueur maximale pour STRING ({"maxLength":600}). null = aucune contrainte au-delà du type.
  allowedValues Json?
  /// Valeur envoyée quand le client n'en fournit pas (obligatoire pour FIXED et HIDDEN_DEFAULT).
  defaultValue  Json?
  /// Vrai si la valeur de ce paramètre entre dans le calcul du coût fournisseur.
  affectsPrice  Boolean            @default(false)
  sortOrder     Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  model GenerationModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, key])
  @@index([modelId, sortOrder])
}

/**
 * Règle de prix d'une option payante, en ajout seul comme ModelPrice : « generate_audio = true ajoute
 * 0,01 $ par seconde », « draft = true multiplie par 0,5 ». Le coût d'une génération reçoit les options
 * RÉELLEMENT envoyées, donc une option non choisie ne se facture pas.
 */
model ModelOptionPrice {
  id              String               @id @default(uuid()) @db.Uuid
  /// Slug du modèle concerné (= GenerationModel.slug), sans clé étrangère : table en ajout seul.
  providerModel   String
  /// Clé du paramètre concerné (= ModelParam.key).
  paramKey        String
  /// Valeur qui déclenche la règle, au format JSON (true, "draft", "1080p").
  triggerValue    Json
  kind            ModelOptionPriceKind
  /// Supplément par unité facturée, en micro-dollars (kind = SURCHARGE).
  microUsdPerUnit BigInt?
  /// Multiplicateur en points de base, 10000 = ×1 (kind = MULTIPLIER).
  multiplierBp    Int?
  source          ModelPriceSource
  effectiveFrom   DateTime
  note            String?
  createdById     String?              @db.Uuid
  createdAt       DateTime             @default(now())

  @@index([providerModel, paramKey, effectiveFrom])
  @@index([effectiveFrom])
}

/**
 * Relevé du prix annoncé par le fournisseur (POST /estimate) comparé au tarif configuré, en ajout seul.
 * Au-delà de 5 % d'écart vers le haut, la tarification retient le PLUS ÉLEVÉ des deux pour les nouveaux
 * devis et l'administration alerte : jamais d'application automatique d'un nouveau tarif.
 */
model ModelEstimateCheck {
  id                        String   @id @default(uuid()) @db.Uuid
  /// Slug du modèle (= GenerationModel.slug).
  providerModel             String
  resolution                String?
  /// Options exactes envoyées à /estimate (celles qui changent le prix).
  options                   Json
  /// Tarif configuré au moment du relevé, en micro-dollars par unité facturée.
  configuredMicroUsdPerUnit BigInt
  /// Tarif observé, ramené à l'unité facturée.
  observedMicroUsdPerUnit   BigInt
  /// Écart relatif en % arrondi au-dessus (positif = le fournisseur est plus cher que la config).
  deviationPercent          Int
  /// Unités facturées de la demande estimée (sert à ramener le prix total à l'unité).
  units                     Int
  /// Réponse brute du fournisseur : sa forme n'est pas garantie par la documentation.
  raw                       Json?
  note                      String?
  createdById               String?  @db.Uuid
  checkedAt                 DateTime @default(now())

  @@index([providerModel, resolution, checkedAt])
  @@index([checkedAt])
}

/**
 * Devis affiché au client, gardé côté serveur pour un temps réglable (`quoteValiditySeconds`, 10 min par
 * défaut). Appliquer une nouvelle configuration prend effet tout de suite sur les NOUVEAUX devis ; un devis
 * déjà affiché reste honoré pendant sa validité — à la condition absolue qu'il couvre encore le coût
 * fournisseur, la règle « jamais sous le coût » passant avant la promesse commerciale.
 */
model CreationQuote {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  /// Slug du modèle et paramètres EXACTS : un devis ne vaut que pour ces paramètres.
  modelSlug       String
  resolution      String?
  durationSeconds Int
  options         Json
  credits         Int
  costMicroUsd    BigInt
  pricingConfigId String?   @db.Uuid
  expiresAt       DateTime
  /// Date d'utilisation : un devis ne sert qu'une fois.
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}
