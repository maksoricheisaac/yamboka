# ───── API (NestJS) ─────
# Copier ce fichier en `.env` (ignoré par Git). Ne jamais y mettre de vraie clé.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# URLs publiques (CORS et liens des e-mails)
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
APP_URL=http://localhost:3001

# ───── Base de données (PostgreSQL via docker/docker-compose.dev.yml, port 5433) ─────
DATABASE_URL="postgresql://yamboka:yamboka_dev_password@localhost:5433/yamboka_dev"

# ───── File de tâches (Redis, BullMQ) ─────
REDIS_URL="redis://localhost:6380"
# Active par défaut, sauf en test (exécution directe). `true` ou `false` pour forcer.
# QUEUE_ENABLED=

# ───── Sessions ─────
# Au moins 32 caractères aléatoires. Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_DAYS=30
# Domaine du cookie en production (ex. .yamboka.com) ; laisser vide en local.
COOKIE_DOMAIN=
# Nombre de proxys de confiance devant l'API (0 en local ; navigateur → Next → API = 2).
TRUST_PROXY=0

# ───── Premier compte administrateur (créé par `pnpm db:seed`) ─────
ADMIN_EMAIL=admin@yamboka.local
ADMIN_PASSWORD=

# ───── Fournisseurs : phase 1 = simulation uniquement ─────
PAYMENT_PROVIDER=mock
GENERATION_PROVIDER=mock
EMAIL_PROVIDER=console
STORAGE_DRIVER=local

# ───── Connexion Google (optionnelle : sans ces 3 variables, le bouton Google est masqué) ─────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ───── Réservé aux intégrations ultérieures (non lues en phase 1) ─────
# OPENPAY_API_URL=
# OPENPAY_API_KEY=
# HF_API_KEY_ID=
# HF_API_KEY_SECRET=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
