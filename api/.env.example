# ───── API (NestJS) ─────
# Copier ce fichier en `.env` (ignoré par Git). Ne jamais y mettre de vraie clé ni de vrai mot de passe.
# En production (Dokploy), ces variables se définissent dans l'onglet « Environment » du service, jamais dans le dépôt.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ───── URLs publiques (CORS, protection CSRF et liens des e-mails) ─────
# API_URL : adresse publique de l'API. APP_URL : espace client/admin. WEB_URL : site public.
API_URL=http://localhost:4000
APP_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# ───── Base de données (PostgreSQL via docker/docker-compose.dev.yml, port 5433) ─────
DATABASE_URL="postgresql://yamboka:yamboka_dev_password@localhost:5433/yamboka_dev"

# ───── File de tâches (Redis, BullMQ) ─────
REDIS_URL="redis://localhost:6380"
# Active par défaut, sauf en test (exécution directe). `true` ou `false` pour forcer.
# QUEUE_ENABLED=

# ───── Sessions ─────
# Au moins 32 caractères aléatoires. Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Sert aussi à protéger les codes à usage unique (HMAC) : le changer invalide les codes en cours.
SESSION_SECRET=
SESSION_TTL_DAYS=30
# Domaine du cookie en production (ex. .yamboka.com) ; laisser vide en local.
COOKIE_DOMAIN=
# Nombre de proxys de confiance devant l'API (0 en local ; navigateur → Next → API = 2).
TRUST_PROXY=0

# ───── Premier administrateur : Setup Wizard (production) ─────
# Tant que la plateforme n'est pas initialisée, la page /installation de l'application exige ce secret
# (24 caractères minimum, aléatoire). Générer : node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Une fois l'installation terminée, l'assistant est verrouillé définitivement en base : RETIREZ cette variable.
SETUP_SECRET=

# ───── Administrateur de développement et de test (créé par `pnpm db:seed`) ─────
# NE PAS DÉFINIR en production : utilisez le Setup Wizard.
ADMIN_EMAIL=admin@yamboka.local
ADMIN_PASSWORD=

# ───── E-mails ─────
# console : développement, aucun e-mail réel (rien n'est envoyé, les messages restent en mémoire).
# smtp    : envoi réel via le serveur SMTP ci-dessous (obligatoire en production).
EMAIL_PROVIDER=console
# Expéditeur. Doit appartenir au domaine autorisé par votre fournisseur (SPF/DKIM) : voir docs/dev/emails-et-otp.md
EMAIL_FROM="Yamboka <no-reply@yamboka.local>"
# Adresse de réponse (facultatif).
EMAIL_REPLY_TO=

# Serveur SMTP : valeurs fournies par votre hébergeur de messagerie (aucune valeur par défaut n'est un vrai identifiant).
# Port 587 + SMTP_SECURE=false : STARTTLS (chiffrement exigé). Port 465 + SMTP_SECURE=true : TLS implicite.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ───── Codes à usage unique (OTP) envoyés par e-mail ─────
EMAIL_OTP_LENGTH=6
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_SENDS_PER_HOUR=5

# ───── Fournisseurs ─────
PAYMENT_PROVIDER=mock

# ───── SasPay (https://docs.saspay.me) — paiements RÉELS, pas de bac à sable ─────
# Clé de scope PAYIN créée dans le tableau de bord (affichée une seule fois). Une clé distincte par environnement.
# Valeurs fictives ci-dessous : ne jamais committer une vraie clé.
SASPAY_API_BASE_URL=https://api.saspay.me/api/v1
SASPAY_API_KEY=
# signing_secret du webhook (Développeur → Webhooks), affiché une seule fois.
SASPAY_WEBHOOK_SECRET=
SASPAY_TIMEOUT_MS=15000

# Génération IA. mock : simulée, aucun coût. higgsfield : appels RÉELS et PAYANTS (identifiants ci-dessous requis).
GENERATION_PROVIDER=mock
# Durée d’une génération simulée (secondes) : laisser 0 en test ; quelques secondes pour voir la progression.
MOCK_GENERATION_SECONDS=0
# Console Higgsfield → clés API. HF_API_KEY_SECRET peut être le secret seul, ou la paire « identifiant:secret ».
# HF_API_KEY_ID=
# HF_API_KEY_SECRET=
# HF_API_URL=https://api.higgsfield.ai

# Stockage des fichiers. local : dossier LOCAL_STORAGE_DIR (développement). r2 : Cloudflare R2 (bucket privé).
STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=./storage
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# ───── Connexion Google (optionnelle : sans ces 3 variables, le bouton Google est masqué) ─────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ───── Réservé à une intégration ultérieure (non lu) ─────
# OPENPAY_API_URL=
# OPENPAY_API_KEY=

# Rafraichissement immediat des prix du site public apres une modification de pack ou de produit (16 caracteres minimum).
# Meme valeur des deux cotes ; sans elle, le site public se met a jour a l expiration de son cache.
# REVALIDATE_SECRET=
