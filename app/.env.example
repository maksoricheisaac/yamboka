# Application privée (Next.js, port 3001).
# Seules les variables NEXT_PUBLIC_* sont visibles du navigateur : n'y mettre aucun secret.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Serveur uniquement : adresse interne de l'API (relais /api/* et lecture de la session côté serveur).
API_INTERNAL_URL=http://localhost:4000
