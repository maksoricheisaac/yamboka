# Site public (Next.js, port 3000). Seules les variables NEXT_PUBLIC_* sont visibles du navigateur :
# n'y mettre aucun secret.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000
# Serveur uniquement : adresse interne de l'API, pour lire les offres publiées (3 packs maximum).
# Si l'API est injoignable, le site affiche les offres du business plan.
API_INTERNAL_URL=http://localhost:4000
# Numéro WhatsApp de contact, format international sans « + » : 242XXXXXXXXX.
# Sans lui, le bouton WhatsApp de la page contact est masqué.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Meme valeur que REVALIDATE_SECRET cote API (rafraichissement immediat des offres).
# REVALIDATE_SECRET=
