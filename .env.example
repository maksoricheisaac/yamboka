# ════════════════════════════════════════════════════════════════════════════════
# Modèle des fichiers d'environnement — à copier à la RACINE sous le nom de l'environnement :
#   .env.local · .env.dev · .env.staging · .env.prod        (tous ignorés par Git)
# Une seule source de vérité pour api, web, app et Docker Compose. Aucune vraie valeur dans ce fichier.
#
# Utilisation :  docker compose --env-file .env.<env> -f docker/docker-compose.<env>.yml up -d
# Sur Dokploy : coller le contenu du fichier dans l'onglet « Environment » du projet Compose.
# Les commentaires « local » / « distant » indiquent la valeur attendue selon l'environnement.
# ════════════════════════════════════════════════════════════════════════════════

# ───── Infrastructure ─────
# local | dev | staging | prod. Sert à nommer les alias réseau internes (api-<ENV_NAME>, web-<ENV_NAME>).
ENV_NAME=prod
# Unique par environnement : isole conteneurs, réseaux et volumes sur un même serveur.
COMPOSE_PROJECT_NAME=yamboka-prod
# Site public : landing et pages publiques uniquement (aucune route /api). local : localhost.
DOMAIN=domaine.com
# Espace membre (+ API sous /api). Toujours « app. » + DOMAIN. local : localhost.
APP_DOMAIN=app.domaine.com
# API publique directe (webhooks, intégrations externes). Toujours « api. » + DOMAIN. local : sans objet.
# Le navigateur, lui, continue de passer par https://<APP_DOMAIN>/api (cookie même origine).
API_DOMAIN=api.domaine.com
# Facultatif — étiquette des images construites (déploiement d'une version précise).
# IMAGE_TAG=latest

# ───── URLs publiques ─────
# Distant : https://<DOMAIN>, https://<APP_DOMAIN>, https://<API_DOMAIN>.
#   WEB_URL / APP_URL : origines du navigateur (CORS, CSRF, liens des e-mails, retours de paiement).
#   API_URL : adresse publique directe de l'API (webhooks, intégrations). Le navigateur n'y est PAS envoyé.
# Local : http://localhost:3000, http://localhost:3001, http://localhost:4000.
WEB_URL=https://domaine.com
APP_URL=https://app.domaine.com
API_URL=https://api.domaine.com
# Lues par la landing et l'espace membre, FIGÉES dans le bundle au build (publiques par nature : aucun secret).
# Doivent être égales à WEB_URL et APP_URL. Les liens « Connexion » / « Inscription » de la navbar en dérivent.
NEXT_PUBLIC_SITE_URL=https://domaine.com
NEXT_PUBLIC_APP_URL=https://app.domaine.com
# Numéro WhatsApp de contact, format international sans « + » (ex. 242XXXXXXXXX). Vide : bouton masqué.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Hors Docker uniquement (pnpm dev:*) : adresse de l'API vue par les deux Next.js. En conteneur, Compose la fixe.
# API_INTERNAL_URL=http://localhost:4000

# ───── PostgreSQL ─────
# Le mot de passe est inséré dans une URL de connexion : caractères alphanumériques (ou - _ . ~) uniquement.
# Générer : node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_USER=yamboka
POSTGRES_PASSWORD=
POSTGRES_DB=yamboka_prod
# local uniquement : ports publiés sur 127.0.0.1, et URLs de connexion pour une API lancée hors Docker.
# POSTGRES_PORT=5433
# REDIS_PORT=6380
# DATABASE_URL="postgresql://yamboka:<mot-de-passe>@localhost:5433/yamboka_dev"
# REDIS_URL="redis://localhost:6380"

# ───── API : général ─────
# info en staging/prod ; debug possible en dev.
LOG_LEVEL=info
# Au moins 32 caractères aléatoires, DIFFÉRENT dans chaque environnement.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_DAYS=30
# Nombre de proxys de confiance devant l'API : 1 (Traefik) à distance ; 0 en local.
TRUST_PROXY=1
# Secret du Setup Wizard (24 caractères minimum). À RETIRER une fois la plateforme initialisée.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SETUP_SECRET=
# Même valeur côté API et côté landing (16 caractères minimum) : rafraîchit les prix publics après modification d'une offre.
# Générer : node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
REVALIDATE_SECRET=
# true (défaut) : l'API exécute elle-même les tâches BullMQ (paiements, générations, crédits, e-mails).
# false : uniquement le jour où un conteneur worker dédié (`node dist/worker`, RUN_PROCESSORS=true) tourne à côté ;
# sans consommateur, plus rien ne s'exécute. Ne pas modifier tant qu'aucun worker n'est déployé.
# RUN_PROCESSORS=true
# local uniquement (créé par `pnpm db:seed`) : NE PAS définir à distance, utiliser le Setup Wizard.
# ADMIN_EMAIL=admin@yamboka.local
# ADMIN_PASSWORD=

# ───── E-mails ─────
# console : rien n'est envoyé (dev). smtp : envoi réel, obligatoire en production.
EMAIL_PROVIDER=smtp
EMAIL_FROM="Yamboka <no-reply@domaine.com>"
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ───── Paiements (SasPay : paiements RÉELS, pas de bac à sable — une clé distincte par environnement) ─────
# mock : simulé. saspay : réel. Webhook à déclarer chez SasPay : <API_URL>/api/webhooks/saspay (voir README).
PAYMENT_PROVIDER=mock
SASPAY_API_BASE_URL=https://api.saspay.me/api/v1
SASPAY_API_KEY=
SASPAY_WEBHOOK_SECRET=

# ───── Génération IA ─────
# mock : simulée, aucun coût. higgsfield : appels RÉELS et PAYANTS.
GENERATION_PROVIDER=mock
MOCK_GENERATION_SECONDS=0
HF_API_KEY_ID=
HF_API_KEY_SECRET=

# ───── Stockage des fichiers ─────
# local : volume Docker (dev). r2 : Cloudflare R2, bucket privé (recommandé en staging/prod).
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ───── Connexion Google (facultative : sans ces 3 variables, le bouton est masqué) ─────
# GOOGLE_CALLBACK_URL distant : https://<APP_DOMAIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
